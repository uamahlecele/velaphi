<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/output.css">
    <title>Could not find surname | Velaphi</title>
</head>

<body
    class="min-h-screen bg-[url('/images/Texturelabs_Paper_381XL.jpg')] bg-cover bg-fixed font-poppins text-white flex flex-col justify-between">

    <!-- Navigation Bar (matches index.html and index.ejs sizing and spacing) -->
    <header class="w-full px-5 py-6 md:px-10 md:py-10 fade-in delay-1">
        <nav class="flex items-center justify-between text-[clamp(1.2rem,2.5vw,2rem)]">
            <a href="/index.html" class="hover:text-velaphiYellow transition-colors duration-200">velaphi</a>
            <a href="/about.html" class="hover:text-velaphiYellow transition-colors duration-200">about</a>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main
        class="max-w-4xl mx-auto px-6 sm:px-8 w-full flex-grow flex flex-col items-center justify-center text-center py-8">
        <!-- Main Heading -->
        <h1 class="font-sentient text-velaphiYellow text-4xl sm:text-5xl md:text-6xl font-normal pt-2 pb-4 tracking-wide fade-in delay-2">
            Could not find surname
        </h1>

        <!-- Feedback Subtitle -->
        <% if (searchedSurname) { %>
            <p class="text-white/85 text-base sm:text-lg max-w-xl mx-auto mb-8 font-light fade-in delay-3">
                We couldn't find any information for "<span class="text-velaphiYellow font-medium">
                    <%= searchedSurname %>
                </span>". Try searching again or select from the available surnames below.
            </p>
        <% } else { %>
            <p class="text-white/85 text-base sm:text-lg max-w-xl mx-auto mb-8 font-light fade-in delay-3">
                Please enter a surname or select from the available surnames below.
            </p>
        <% } %>

        <!-- Search Input Form -->
        <div class="w-full max-w-md mx-auto mb-10 fade-in delay-4">
            <form action="/surname" method="get">
                <input class="w-full h-11 px-5 rounded-full text-black text-center outline-none focus:ring-2 focus:ring-velaphiYellow bg-white placeholder-gray-500 shadow-md transition text-base"
                       type="text" 
                       name="inputSearch" 
                       autocomplete="off" 
                       placeholder="Search another surname...">
            </form>
        </div>

        <!-- Available Surnames Library -->
        <div class="surname-lib w-full max-w-3xl mx-auto mt-2 mb-8 fade-in delay-5">
            <h2 class="text-xl md:text-2xl font-semibold text-velaphiYellow tracking-wide mb-6">
                Available Surnames
            </h2>

            <ul class="flex flex-wrap justify-center gap-3 sm:gap-3.5">
                <% surnames.forEach(s => { %>
                    <li id="styleOut" class="inline-block">
                        <a href="/surname?inputSearch=<%= encodeURIComponent(s) %>"
                           class="inline-block px-4 py-2 rounded-full border border-white/20 bg-black/30 text-white hover:text-black hover:bg-velaphiYellow hover:border-velaphiYellow hover:scale-105 active:scale-95 transition-all duration-200 capitalize font-medium text-sm sm:text-base shadow-sm">
                            <%= s %>
                        </a>
                    </li>
                <% }) %>
            </ul>
        </div>
    </main>

    <!-- Footer -->
    <footer class="text-center text-velaphiYellow py-8 mt-8 text-sm fade-in delay-6">
        <p>&copy; 2026 by uAmahle Cele. All rights reserved.</p>
    </footer>

</body>

</html>