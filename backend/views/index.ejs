<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/output.css">
    <title>
        <%=surname%>
    </title>
</head>

<body class="bg-black px-1">

    <nav class="hover: text-velaphiYellow flex items-center justify-between px-2 py-4 text-2xl">
        <a href="./index.html">velaphi</a>
        <a href="./about.html">about</a>
    </nav>
    <h1 class="text-center font-lastik text-velaphiYellow py-5 px-14 font-bold center capitalize text-7xl">
        <%=surname%>
    </h1>

    <h2 class="py-5 text-center text-3xl text-velaphiYellow">Izithakazelo</h2>
    <h2 class="px-88 text-center text-white">
        <%=izithakazelo%>
    </h2>

    <h3 class="px-2 py-2 text-3xl text-center  text-velaphiYellow">Umlando</h3>

    <p class="px-15 font-poppins text-white">
        <%=umlando%>
    </p>

    <h3 class="px-2 py-2
     text-velaphiYellow  text-center text-3xl
     "> Well Known People </h3>

    <div class="w-full h-50 rounded-lg flex justify-center  px-2 font-bold text-white gap-3">


        <!-- Iterates through the JSON list found in the column well_known_people from our database-->
        <% well_known_people.forEach(person=> { %>

            <div class="">
                <% if (person.image) { %> <!-- If true-->
                    <img class=" rounded-lg center p-1 w-full h-full object-cover" src="<%= person.image %>">
                    <% } else { %>
                        <div>No image found</div>
                        <% } %>
                            <p>
                                <%= person.name %>
                                    <ul class="font-light">
                                        <%= person.occupation %>
                                    </ul>
                            </p>

            </div>
            <% }) %>

    </div>
    <br>


    <br>
    <h3 class="px-2 text-white font-bold text-2xl"> Additional Resources</h3>

    <li class="px-2 font-bold text-white "> <a href="https://indabukoyakho.com/2025/06/02/cele/"> Indabuko
            Yakho</a>
    </li>

</body>

</html>