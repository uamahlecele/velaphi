<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/output.css">
    <title>
        <%=surname%>
    </title>
</head>

<body class="min-h-screen bg-[url('/images/Texturelabs_Paper_381XL.jpg')] bg-cover bg-fixed font-poppins text-white flex flex-col justify-between">

    <!-- Navigation Bar (matches index.html sizing and spacing) -->
    <header class="w-full px-5 py-6 md:px-10 md:py-10 fade-in delay-1">
        <nav class="flex items-center justify-between text-[clamp(1.2rem,2.5vw,2rem)]">
            <a href="/index.html" class="hover:text-velaphiYellow transition-colors duration-200">velaphi</a>
            <a href="/about.html" class="hover:text-velaphiYellow transition-colors duration-200">about</a>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-4xl mx-auto px-6 sm:px-8 w-full flex-grow">
        <!-- Surname Title (matches index.html 'velaphi' sentient font) -->
        <h1 class="text-center font-sentient text-velaphiYellow capitalize text-5xl md:text-7xl lg:text-8xl pt-4 pb-8 tracking-wide font-normal fade-in delay-2">
            <%=surname%>
        </h1>

        <!-- Izithakazelo Section -->
        <section class="my-12 md:my-16 text-center fade-in delay-3">
            <h2 class="text-2xl md:text-3xl font-semibold text-velaphiYellow tracking-wide mb-5">Izithakazelo</h2>
            <p class="text-lg md:text-xl text-white/95 leading-relaxed italic max-w-3xl mx-auto whitespace-pre-line px-2 sm:px-4">
                <%=izithakazelo%>
            </p>
        </section>

        <!-- Umlando Section (sectioned into readable paragraphs) -->
        <%
            function getParagraphs(text) {
                if (!text) return [];
                const rawChunks = text.split(/\r?\n+/).map(p => p.trim()).filter(Boolean);
                const result = [];
                for (let chunk of rawChunks) {
                    chunk = chunk.replace(/([.!?])([A-Za-z])/g, '$1 $2');
                    if (chunk.length > 500) {
                        const sentences = chunk.split(/(?<=[.!?])\s+/);
                        let current = '';
                        for (let s of sentences) {
                            if (current && (current + ' ' + s).length > 400) {
                                result.push(current.trim());
                                current = s;
                            } else {
                                current = current ? current + ' ' + s : s;
                            }
                        }
                        if (current.trim()) result.push(current.trim());
                    } else {
                        result.push(chunk);
                    }
                }
                return result;
            }
        %>
        <section class="my-12 md:my-16 fade-in delay-4">
            <h2 class="text-center text-2xl md:text-3xl font-semibold text-velaphiYellow tracking-wide mb-6">Umlando</h2>
            <div class="text-base md:text-lg text-white/90 leading-relaxed text-justify md:text-left px-2 sm:px-4">
                <% getParagraphs(umlando).forEach(paragraph => { %>
                    <p class="mb-5">
                        <%= paragraph %>
                    </p>
                <% }) %>
            </div>
        </section>

        <!-- Abantu Abaziwayo Section -->
        <section class="my-12 md:my-16 fade-in delay-5">
            <h2 class="text-center text-2xl md:text-3xl font-semibold text-velaphiYellow tracking-wide mb-8 capitalize">abantu abaziwayo</h2>

            <div class="flex flex-wrap justify-center gap-8">
                <!-- Iterates through the JSON list found in the column well_known_people from our database -->
                <% well_known_people.forEach(person => { %>
                    <div class="w-60 flex flex-col items-center text-center group transition-transform duration-300 hover:-translate-y-1">
                        <div class="w-48 h-56 rounded-xl overflow-hidden shadow-lg border border-white/10 mb-3 bg-black/20 flex items-center justify-center">
                            <% if (person.image) { %>
                                <img class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" 
                                     src="<%= person.image.startsWith('/') ? person.image : '/' + person.image %>" 
                                     alt="<%= person.name %>">
                            <% } else { %>
                                <div class="text-sm text-white/50 italic px-2">No image found</div>
                            <% } %>
                        </div>
                        <a href="<%= person.links || '#' %>" 
                           target="<%= person.links ? '_blank' : '_self' %>" 
                           class="group-hover:text-velaphiYellow transition-colors duration-200">
                            <div class="font-bold text-lg text-white group-hover:text-velaphiYellow">
                                <%= person.name %>
                            </div>
                            <div class="text-sm font-light text-white/80 mt-1">
                                <%= person.occupation %>
                            </div>
                        </a>
                    </div>
                <% }) %>
            </div>
        </section>

        <!-- Additional Resources Section -->
        <section class="my-12 md:my-16 pt-8 border-t border-white/10 px-2 sm:px-4 fade-in delay-6">
            <h3 class="text-xl md:text-2xl font-bold text-white mb-4">Additional Resources</h3>

            <ul class="space-y-2 text-white/90">
                <li>
                    <a href="https://indabukoyakho.com/2025/06/02/cele/" target="_blank" class="hover:text-velaphiYellow transition-colors duration-200 underline underline-offset-4">
                        Indabuko Yakho
                    </a>
                </li>
                <li>
                    <a href="https://sahistory.org.za/" target="_blank" class="hover:text-velaphiYellow transition-colors duration-200 underline underline-offset-4">
                        SA History
                    </a>
                </li>
                <li>
                    <a href="https://x.com/HistorySAZAR" target="_blank" class="hover:text-velaphiYellow transition-colors duration-200 underline underline-offset-4">
                        HistorySAZAR
                    </a>
                </li>
                <li>
                    <a href="https://cdm21048.contentdm.oclc.org/" target="_blank" class="hover:text-velaphiYellow transition-colors duration-200 underline underline-offset-4">
                        National Library of South Africa
                    </a>
                </li>
            </ul>
        </section>
    </main>

    <!-- Footer -->
    <footer class="text-center text-velaphiYellow py-8 mt-8 text-sm fade-in delay-7">
        <p>&copy; 2026 by uAmahle Cele. All rights reserved.</p>
    </footer>

</body>

</html>